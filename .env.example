# SMTP mailer for the /connect contact form
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tech-society@iiit-bh.ac.in
SMTP_PASS=your-app-password

# Optional — CONTACT_TO defaults to tech-society@iiit-bh.ac.in
MAIL_FROM="TechSoc Website <tech-society@iiit-bh.ac.in>"
CONTACT_TO=tech-society@iiit-bh.ac.in
